class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
         int size = nums.size();
 int candidate = nums[0];
 int k = 1;
 for (int i = 1; i < size; i++) {
     if (candidate != nums[i]) {
         candidate = nums[i];
         nums[k++] = candidate;
     }
 }
 
 return k;
    }
};
